{
  "name": "nodejs-queue",
  "version": "1.0.0",
  "description": "just a simple project using nodejs and redis to send mails and queues",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"node -r ts-node/register src/app.ts\"",
    "dev:debug": "nodemon --watch src --ext ts --exec node --inspect-brk src/app.ts",
    "start": "tsc && node dist/app.js"
  },
  "author": "Gbenga",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.2",
    "bull": "^4.16.5",
    "express": "^5.2.1",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
